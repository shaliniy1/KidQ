# API base URL for local dev — matches api/.env.example's default PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Auth for parent sign-in (T02 — Google Sign-In), same pattern as admin/.env.example.
# The anon key is public by design — never put the service key here.
# Google sign-in must be enabled in Supabase under Authentication > Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
