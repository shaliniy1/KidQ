# API base URL for local dev — matches api/.env.example's default PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase client config (T02 — Google Sign-In). These are public client
# identifiers (safe to ship to the browser), from Firebase Console >
# Project Settings > General > Your apps > Web app > SDK setup and
# configuration. Google Sign-In must also be enabled under
# Authentication > Sign-in method.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
