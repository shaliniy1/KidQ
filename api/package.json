{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "KidQ backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "AUTH_MODE=${AUTH_MODE:-dev} tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:discover": "tsx scripts/seed-discover.ts",
    "seed:sample": "tsx scripts/sample-content.ts load",
    "seed:sample:export": "tsx scripts/sample-content.ts export",
    "jobs:drain": "tsx scripts/drain-jobs.ts",
    "recurate": "tsx scripts/recurate.ts",
    "eval:scoring": "tsx scripts/eval-scoring.ts",
    "openapi:write": "tsx scripts/write-openapi.ts",
    "openapi:check": "tsx scripts/write-openapi.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}