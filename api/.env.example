PORT=4000
# Firebase Admin service-account credentials, for verifying Google Sign-In
# ID tokens server-side (T02). Get these from Firebase Console > Project
# Settings > Service Accounts > Generate new private key. Without these set,
# POST /auth/session returns 501 "not configured" rather than trusting an
# unverified client-supplied identity.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key's "private_key" field verbatim, with \n line breaks kept
# literal (not real newlines) — the app un-escapes them at startup.
FIREBASE_PRIVATE_KEY=
# Required only for official YouTube Data API discovery. Never scrape YouTube.
YOUTUBE_DATA_API_KEY=
# Used for structured KidQ analysis; never expose this in the web app.
OPENAI_API_KEY=
# Optional source credentials for increased Openverse API limits.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# PostgreSQL connection used after applying the content catalog migration.
DATABASE_URL=postgresql://kidq:change-me@localhost:5432/kidq
# Optional; defaults to ./data relative to the API process.
KIDQ_DATA_DIR=./data
