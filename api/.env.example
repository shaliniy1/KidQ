# KidQ API — copy to api/.env for local development. Never commit real values.
PORT=4000
NODE_ENV=development

# Local Postgres, or the Supabase *session pooler* connection string for QA/prod.
DATABASE_URL=postgresql://localhost:5432/kidq
# disable (local) | require (Supabase pooler) | verify-full (+ DATABASE_CA_CERT, prod)
DATABASE_SSL=disable
DATABASE_CA_CERT=
RUN_MIGRATIONS_ON_BOOT=true
RUN_WORKER_IN_PROCESS=true

# supabase (QA/prod) | dev (local only; accepts "Bearer dev:<admin|parent>:<uuid>")
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Browser origins allowed to call the API (web app, admin app, TV wrappers).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Descriptive contact string for source APIs (Wikimedia requires one).
HTTP_USER_AGENT=KidQ-content-ingestion/1.0 (+https://github.com/shaliniy1/KidQ)

# Official YouTube Data API only — KidQ never scrapes YouTube.
YOUTUBE_DATA_API_KEY=

# Gemini AI scoring agent. Free tier: at most 8 hours of YouTube video per day.
GEMINI_API_KEY=
AI_SCORING_MODEL=gemini-3.8-flash
AI_ESCALATION_MODEL=
AI_DAILY_VIDEO_SECONDS_CAP=27000
AI_PROMPT_VERSION=1
# Paid-tier prices, to record estimated spend per assessment (0 on the free tier).
AI_INPUT_USD_PER_MTOK=0
AI_OUTPUT_USD_PER_MTOK=0
KIDQ_RUBRIC_VERSION=2
